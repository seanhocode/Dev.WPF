<UserControl x:Class="Example.WPF.DataBinding.INotifyPropertyChanged.Example1Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Example.WPF.DataBinding.INotifyPropertyChanged"
        mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- 當按下 Add One 按鈕時，Label 上綁定的值雖會增加，但 UI 不會自動更新，需參考 Example2 設定 INotifyPropertyChanged-->
        <Label Grid.Row="0" Name="ValueLabel" Content="{Binding FirstDataContextValue}" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <Button Grid.Row="1" Content="AddOne" FontSize="36" Click="AddOne" />
    </Grid>
</UserControl>
