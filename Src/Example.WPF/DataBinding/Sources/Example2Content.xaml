<UserControl x:Class="Example.WPF.DataBinding.Sources.Example2Content"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Example.WPF.DataBinding.Sources"
             mc:Ignorable="d" >
    <StackPanel>
        <TextBox x:Name="textBox" Text="50" />
        <Label x:Name="label" Content="{Binding ElementName=textBox, Path=Text}" />
    </StackPanel>
</UserControl>
