<UserControl x:Class="Example.WPF.DataBinding.Sources.Example1Content"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Example.WPF.DataBinding.Sources"
             xmlns:dataContent="clr-namespace:Example.WPF.Infrastructure.DataBinding.DataContexts;assembly=Example.WPF.Infrastructure"
             mc:Ignorable="d" >
    <!-- 已於 CodeBehind 中 InitializeComponent() 執行前將 FirstDataContext 加入 Resources -->
    <Grid>
        <TextBlock Text="{Binding Source={StaticResource FirstDataContext}, Path=FirstDataContextTextValue}" 
                   FontSize="36" 
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center" />
    </Grid>
</UserControl>
