<UserControl x:Class="Example.WPF.DataBinding.DependencyProperties.ErrorExample1Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Example.WPF.DataBinding.DependencyProperties"
        xmlns:dataContext="clr-namespace:Example.WPF.Core.Model.DataBinding.DataContexts;assembly=Example.WPF.Core"
        xmlns:userControls="clr-namespace:Example.WPF.DataBinding.DependencyProperties.UserControls"
        mc:Ignorable="d">
    <UserControl.DataContext>
        <dataContext:FirstDataContext />
    </UserControl.DataContext>
    <Grid>
        <userControls:ErrorUserControl ErrorUserControlValue="{Binding FirstDataContextValue}" />
    </Grid>
</UserControl>
